# Google AI Studio key, for the line-by-line meaning. Without it the lyrics
# still get found and stored — only the explanation is skipped, and the song
# page says why.
GEMINI_API_KEY=

# Everything below has a working default (see src/config.ts); these are the
# knobs worth knowing about.
# MEANING_MODEL=gemini-2.5-flash
# MIN_SCORE=0.45          # never show a candidate below this; a wrong answer is
#                         # worse than "nothing found"
# MAX_PAGES_PER_SEARCH=8
# PER_HOST_DELAY_MS=700

# PORT and CACHE_DIR are set by run.sh — don't put them here, or they will win
# over it (dotenv does not overwrite a real env var, but run.sh exports these
# per-process, so keeping them in one place avoids the confusion).
